# ===========================================
# Backend API
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# Auth (next-auth)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Base URL of THIS app (used by /api/auth/*, register and logout flows). No trailing slash.
AUTH_URL=http://localhost:3000
# Required when running behind a proxy / standalone build (e.g. AccuWeb). Safe as true in dev.
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=vento-web
# Client secret from Keycloak Admin Console -> Clients -> vento-web -> Credentials
AUTH_KEYCLOAK_SECRET=
# Must match the public URL where Keycloak serves OIDC metadata (no trailing slash).
# Verify from your machine (expect HTTP 200 and JSON, not nginx 404 HTML):
#   curl -sS -o /dev/null -w '%{http_code}\n' 'http://localhost:8080/realms/vento/.well-known/openid-configuration'
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/vento

# ===========================================
# Keycloak (public — federated logout in the browser)
# ===========================================
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=vento
# Same value as AUTH_KEYCLOAK_ISSUER when Keycloak uses a path prefix (e.g. .../identity/realms/vento).
# If unset, logout URL is built as NEXT_PUBLIC_KEYCLOAK_URL + /realms/ + NEXT_PUBLIC_KEYCLOAK_REALM
# NEXT_PUBLIC_KEYCLOAK_ISSUER=https://example.com/identity/realms/vento
