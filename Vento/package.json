{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run",
    "test:json": "vitest run --reporter=default --reporter=json --outputFile=quality-evidence/reports/vitest.json",
    "qa:collect": "npm run test:json && node ai-pipeline-analyzer/quality-attributes-collect.mjs",
    "qa:ai": "node ai-pipeline-analyzer/ai-pipeline-analyzer.mjs",
    "qa:ai:local": "node --env-file=.env.local ai-pipeline-analyzer/ai-pipeline-analyzer.mjs",
    "qa:gate": "node ai-pipeline-analyzer/deployment-gate.mjs",
    "qa:gate:local": "node --env-file=.env.local ai-pipeline-analyzer/deployment-gate.mjs",
    "qa:pipeline": "npm run qa:collect && npm run qa:ai && npm run qa:gate",
    "qa:pipeline:local": "npm run qa:collect && npm run qa:ai:local && npm run qa:gate:local",
    "qa:simulate": "node ai-pipeline-analyzer/qa-simulate.mjs",
    "qa:attributes": "npm run qa:collect"
  },
  "dependencies": {
    "@deck.gl/core": "~9.2.11",
    "@deck.gl/geo-layers": "~9.2.11",
    "@deck.gl/layers": "~9.2.11",
    "@deck.gl/react": "~9.2.11",
    "@luma.gl/core": "~9.2.6",
    "@luma.gl/webgl": "~9.2.6",
    "h3-js": "^4.4.0",
    "jose": "^6.0.6",
    "maplibre-gl": "^5.21.1",
    "next": "^16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
