{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/not-authorized/layout,_N_T_/not-authorized/page,_N_T_/not-authorized"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/not-authorized/__PAGE__",
    "/not-authorized",
    "/_index",
    "/_head"
  ]
}